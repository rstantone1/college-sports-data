# Postgres connection string. Local dev example below; for Supabase use the pooled connection string from the dashboard.
DATABASE_URL=postgres://postgres@localhost:5433/csd?host=/tmp
# Polite request pacing for ESPN's public JSON (milliseconds between requests)
FETCH_DELAY_MS=350
# CollegeFootballData.com API key (free at https://collegefootballdata.com/key). Optional second source.
CFBD_API_KEY=
